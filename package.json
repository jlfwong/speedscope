{
  "name": "speedscope",
  "version": "1.25.0",
  "description": "",
  "repository": "jlfwong/speedscope",
  "main": "index.js",
  "bin": {
    "speedscope": "./bin/cli.mjs"
  },
  "scripts": {
    "deploy": "./scripts/deploy.sh",
    "experiment:benchmark": "tsx scripts/cloud-control-plane.ts benchmark",
    "experiment:benchmark-rust-sampled": "node --expose-gc --import tsx scripts/benchmark-rust-sampled.ts",
    "experiment:build-rust-wasm": "PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build rust/speedscope-importer --target web --out-dir ../../src/experimental/rust-importer/pkg-web --release && PATH=\"$HOME/.cargo/bin:$PATH\" wasm-pack build rust/speedscope-importer --target nodejs --out-dir ../../src/experimental/rust-importer/pkg-node --release && node scripts/postprocess-rust-wasm-packages.js",
    "experiment:collect-artifacts": "tsx scripts/cloud-control-plane.ts collect-artifacts",
    "experiment:compare": "tsx scripts/cloud-control-plane.ts compare",
    "experiment:doctor": "tsx scripts/cloud-control-plane.ts doctor",
    "experiment:gate": "tsx scripts/cloud-control-plane.ts gate",
    "experiment:graph": "tsx scripts/cloud-control-plane.ts graph",
    "experiment:report": "tsx scripts/cloud-control-plane.ts report",
    "experiment:run-package": "tsx scripts/cloud-control-plane.ts run-package",
    "experiment:run-ready": "tsx scripts/cloud-control-plane.ts run-ready",
    "experiment:sync": "tsx scripts/cloud-control-plane.ts sync",
    "prepack": "./scripts/prepack.sh --outdir \"$(pwd)/dist/release\" --protocol file",
    "prettier": "prettier --write 'src/**/*.ts' 'src/**/*.tsx'",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx'",
    "jest": "./scripts/test-setup.sh && jest --runInBand",
    "coverage": "npm run jest -- --coverage",
    "typecheck": "tsc --noEmit",
    "test": "./scripts/ci.sh",
    "showcase:install": "npm --prefix site install",
    "showcase:dev": "npm --prefix site run dev",
    "showcase:build": "npm --prefix site run build",
    "serve": "tsx scripts/dev-server.ts",
    "serve:classic-ui": "tsx scripts/dev-server.ts --port=8000 --host=127.0.0.1 --import-engine=legacy",
    "serve:wasm-ui": "tsx scripts/dev-server.ts --port=8001 --host=127.0.0.1 --import-engine=experimental",
    "serve:side-by-side": "tsx scripts/serve-side-by-side.ts --host=127.0.0.1 --legacy-port=8000 --experimental-port=8001"
  },
  "files": [
    "bin/cli.mjs",
    "dist/release/**",
    "!*.map"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cursor/february": "^1.0.1",
    "@types/jest": "22.2.3",
    "@types/jszip": "3.1.4",
    "@types/node": "14.0.1",
    "@types/pako": "1.0.0",
    "@typescript-eslint/eslint-plugin": "6.16.0",
    "@typescript-eslint/parser": "6.16.0",
    "acorn": "7.2.0",
    "aphrodite": "2.1.0",
    "esbuild": "0.27.0",
    "esbuild-jest": "0.5.0",
    "eslint": "8.0.0",
    "eslint-plugin-prettier": "5.1.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "29.7.0",
    "jfrview": "0.2.0",
    "jsverify": "0.8.3",
    "jszip": "3.1.5",
    "pako": "1.0.6",
    "preact": "10.4.1",
    "prettier": "3.1.1",
    "protobufjs": "6.8.8",
    "source-map": "0.6.1",
    "ts-jest": "29.4.6",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-json-schema": "0.67.0",
    "uglify-es": "3.2.2",
    "uint8array-json-parser": "0.0.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": "esbuild-jest"
    },
    "transformIgnorePatterns": [],
    "setupFilesAfterEnv": [
      "./src/jest-setup.js"
    ],
    "moduleNameMapper": {
      "\\jfrview_bg.wasm$": "<rootDir>/src/import/java-flight-record.mock.ts"
    },
    "testRegex": "\\.test\\.tsx?$",
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.{ts,tsx}"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "dependencies": {
    "open": "10.1.0"
  }
}
